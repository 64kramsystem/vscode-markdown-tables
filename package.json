{
  "name": "markdown-tables",
  "displayName": "Markdown Tables: Bold, Colors & Sort",
  "description": "Edit and sort Markdown tables, with row colors and color-name completion.",
  "version": "0.4.0",
  "publisher": "64kramsystem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/64kramsystem/vscode-markdown-tables.git"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownTables.bold",
        "title": "Toggle Bold",
        "category": "Markdown Tables"
      },
      {
        "command": "markdownTables.sort",
        "title": "Sort by column[s]",
        "category": "Markdown Tables",
        "enablement": "editorLangId == markdown && markdownTables.inTable"
      },
      {
        "command": "markdownTables.insertColumn",
        "title": "Insert Column",
        "category": "Markdown Tables",
        "enablement": "editorLangId == markdown && !editorReadonly && markdownTables.inTable"
      },
      {
        "command": "markdownTables.insertRow",
        "title": "Insert Row",
        "category": "Markdown Tables",
        "enablement": "editorLangId == markdown && !editorReadonly && markdownTables.inTable"
      },
      {
        "command": "markdownTables.appendRow",
        "title": "Append Row",
        "category": "Markdown Tables",
        "enablement": "editorLangId == markdown && !editorReadonly && markdownTables.inTable"
      }
    ],
    "keybindings": [
      {
        "command": "markdownTables.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && markdownTables.selectedTableRow"
      }
    ],
    "configuration": {
      "title": "Markdown Tables",
      "properties": {
        "markdownTables.colorColumns": {
          "type": "string",
          "default": "Color",
          "description": "Comma-separated table header names containing row background colors. Matches ignore case and surrounding spaces. The first valid color from left to right wins."
        }
      }
    },
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "color-name": "^1.1.4",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
